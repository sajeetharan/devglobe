{
  "name": "devglobe-developer-discovery",
  "displayName": "DevGlobe.dev Developer Discovery",
  "description": "The open-source talent graph for humans and AI agents. Find developers and connect agents from VS Code.",
  "version": "0.1.0",
  "publisher": "devglobedev",
  "license": "MIT",
  "icon": "images/icon.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#080b10",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "developers",
    "discovery",
    "github",
    "mcp",
    "agents"
  ],
  "homepage": "https://www.devglobe.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/sajeetharan/devglobe.git",
    "directory": "extensions/vscode"
  },
  "bugs": {
    "url": "https://github.com/sajeetharan/devglobe/issues"
  },
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devglobedev.searchDevelopers",
        "title": "Find a Developer",
        "category": "DevGlobe.dev"
      },
      {
        "command": "devglobedev.openMyProfile",
        "title": "Open My Profile",
        "category": "DevGlobe.dev"
      },
      {
        "command": "devglobedev.copyIdentityCardUrl",
        "title": "Copy My Identity Card Link",
        "category": "DevGlobe.dev"
      },
      {
        "command": "devglobedev.copyMcpConfiguration",
        "title": "Copy MCP Configuration",
        "category": "DevGlobe.dev"
      },
      {
        "command": "devglobedev.openAgentSetup",
        "title": "Open Agent Setup",
        "category": "DevGlobe.dev"
      },
      {
        "command": "devglobedev.startPresence",
        "title": "Start Sharing Coding Presence",
        "category": "DevGlobe.dev"
      },
      {
        "command": "devglobedev.stopPresence",
        "title": "Stop Sharing Coding Presence",
        "category": "DevGlobe.dev"
      }
    ],
    "configuration": {
      "title": "DevGlobe.dev",
      "properties": {
        "devglobedev.githubLogin": {
          "type": "string",
          "default": "",
          "description": "Your public GitHub login, used for profile and identity-card commands."
        },
        "devglobedev.baseUrl": {
          "type": "string",
          "default": "https://www.devglobe.dev",
          "description": "DevGlobe web origin. HTTPS is required except for localhost development."
        },
        "devglobedev.presence.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Share an opt-in coding heartbeat on the DevGlobe live globe. No file paths, repository names, or source code are sent."
        },
        "devglobedev.presence.shareActiveLanguage": {
          "type": "boolean",
          "default": true,
          "description": "Include the active editor language in coding presence heartbeats."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/extension.js && node --check src/devglobe.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}